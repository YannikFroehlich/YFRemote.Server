<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <!-- Spiegelt die Ausschluesse in YFRemote.Server.csproj: Tests fuer Windows-only-Dienste und
       fuer Updates/ (Velopack) koennen auf dem Linux-Ziel nicht kompilieren. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows'">
    <Compile Remove="**\Windows*Tests.cs" />
    <Compile Remove="Updates\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\YFRemote.Server.csproj" />
  </ItemGroup>

</Project>
