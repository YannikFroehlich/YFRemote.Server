<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="8dp"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/widget_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="@string/widget_no_device"
        android:textColor="@color/brand_text_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_volume_down"
            style="@style/WidgetButton"
            android:contentDescription="@string/widget_volume_down"
            android:src="@drawable/ic_widget_volume_down" />

        <ImageButton
            android:id="@+id/widget_previous"
            style="@style/WidgetButton"
            android:contentDescription="@string/widget_previous"
            android:src="@drawable/ic_widget_previous" />

        <ImageButton
            android:id="@+id/widget_play_pause"
            style="@style/WidgetButton"
            android:contentDescription="@string/widget_play_pause"
            android:src="@drawable/ic_widget_play_pause" />

        <ImageButton
            android:id="@+id/widget_next"
            style="@style/WidgetButton"
            android:contentDescription="@string/widget_next"
            android:src="@drawable/ic_widget_next" />

        <ImageButton
            android:id="@+id/widget_volume_up"
            style="@style/WidgetButton"
            android:contentDescription="@string/widget_volume_up"
            android:src="@drawable/ic_widget_volume_up" />
    </LinearLayout>
</LinearLayout>
