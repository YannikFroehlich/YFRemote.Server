<?xml version="1.0" encoding="utf-8"?>
<!-- Medien-Widget (remote/MediaWidget): steuert das zuletzt geoeffnete Geraet, ohne Aktualisierung
     im Intervall - es zeigt nur dessen Namen, und der aendert sich nur beim Oeffnen eines Geraets. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="60dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:resizeMode="horizontal"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_media"
    android:previewLayout="@layout/widget_media"
    android:description="@string/widget_description"
    android:widgetCategory="home_screen" />
