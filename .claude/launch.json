{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "yfremote-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "client",
        "run",
        "start",
        "--",
        "--port",
        "4301"
      ],
      "port": 4301
    },
    {
      "name": "yfremote-server",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "run",
        "--configuration",
        "Release",
        "--framework",
        "net10.0-windows10.0.17763.0"
      ],
      "port": 5050
    },
    {
      "name": "yfremote-server-dll",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "bin/Release/net10.0-windows10.0.17763.0/YFRemote.Server.dll"
      ],
      "port": 5050
    },
    {
      "name": "yfremote-server-https",
      "runtimeExecutable": "dotnet",
      "runtimeArgs": [
        "bin/Release/net10.0-windows10.0.17763.0/YFRemote.Server.dll",
        "Https:Enabled=true"
      ],
      "port": 5050
    }
  ]
}