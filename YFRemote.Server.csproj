<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows;net10.0</TargetFrameworks>
    <OutputType Condition="'$(TargetFramework)' == 'net10.0-windows'">WinExe</OutputType>
    <OutputType Condition="'$(TargetFramework)' != 'net10.0-windows'">Exe</OutputType>
    <UseWindowsForms Condition="'$(TargetFramework)' == 'net10.0-windows'">true</UseWindowsForms>
    <!-- Restore/Build eines crosstargeted Projekts wertet immer ALLE TargetFrameworks aus,
         auch wenn ein einzelner dotnet Aufruf mit der framework Option nur eines davon baut
         - das betrifft schon die Restore Graph Ermittlung, bevor die Framework Auswahl greift.
         Ohne dieses Flag bricht das auf einem echten Linux/macOS Build Host mit NETSDK1100 ab,
         sobald das Projekt ueberhaupt evaluiert wird (auch nur fuers net10.0 Ziel). Auf Windows
         ist es wirkungslos, da dort ohnehin nativ aufgeloest wird. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <Product>YFRemote</Product>
    <Description>Lokaler Server fuer YFRemote</Description>
    <!-- Der Angular-Client und das Android-Gradle-Projekt liegen im selben Repo. Ohne diesen
         Ausschluss saugen die Default-Globs des Web-SDK (**/*.json &amp; Co.) den kompletten
         client- bzw. Gradle-Baum inklusive node_modules/.gradle in den Publish-Output. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);client\**;android\**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Tray, Updates und die Windows-Input-/Startup-Dienste haengen an WinForms/Velopack und
       existieren fuer das Linux-Ziel (noch) nicht - siehe Stufe 2/3 des Linux-Plans. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net10.0-windows'">
    <Compile Remove="Tray\**\*.cs" />
    <Compile Remove="Services\Windows*.cs" />
    <Compile Remove="Updates\**\*.cs" />
  </ItemGroup>

  <!-- Der uinput-basierte Linux-Eingabepfad (Stufe 2) braucht libc-P/Invoke und existiert nur
       fuer das Linux-Ziel. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <Compile Remove="Services\Linux*.cs" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
